{
  "name": "local-epub-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "lint": "eslint src --max-warnings=0",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/build-tauri-portable.mjs",
    "android:init": "node scripts/run-android.mjs init",
    "android:dev": "node scripts/run-android.mjs dev",
    "android:build": "node scripts/run-android.mjs build"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
