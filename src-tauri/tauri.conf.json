{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local EPUB Reader",
  "version": "0.1.0",
  "identifier": "com.localepubreader.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --host 127.0.0.1 --port 5173",
      "wait": true
    },
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local EPUB Reader",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
